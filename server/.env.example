# ---------------------------------------------------------------------------
# LabNova Scientific — backend environment variables
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# ---------------------------------------------------------------------------

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL (Railway "Connect" tab gives you all of these — Railway calls the
# host/user/password/database MYSQLHOST/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE,
# just map them into the names below)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=labnova
# Railway (and some other hosts) require SSL — set to "true" if your
# provider requires it. Local MySQL usually does not.
DB_SSL=false

# Admin login (hardcoded credentials — no admin registration/signup exists).
# Change these before you deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# JWT signing secret for the admin session token. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Gmail SMTP — used to email new quotation requests to the LabNova inbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=LabNova
# Where quotation request emails are delivered. Defaults to SMTP_USER if left blank.
QUOTE_NOTIFICATION_EMAIL=
